# =============================================================
#  InvoEasy .gitignore
#  Covers: Python backend, React (Vite) frontend, macOS, editors
# =============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
venv/
.venv/
env/
ENV/

# ── Environment variables (MUST NEVER BE COMMITTED) ─────────
# Covers every .env variant in the backend root AND invoeasy-mvp/
.env
.env.*
!.env.example

# ── Node / React (invoeasy-mvp) ─────────────────────────────
node_modules/
# dist/ already listed above under Python — shared entry
*.tsbuildinfo

# ── macOS ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editor / IDE ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~