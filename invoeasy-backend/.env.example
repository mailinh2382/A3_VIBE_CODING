# Supabase publishable (anon) key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# PostgreSQL connection URL (URL-encode special characters in password)
# Example: if password is MyPass@123, write MyPass%40123
DATABASE_URL=postgresql://postgres.your-project-id:your-url-encoded-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres